# ==============================================================================
# FarmKonnect Environment Template
# Production Domain: https://farmkonnect.zirocreativeagency.co.ke
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-with-deploy/rotate_credentials.py

# PostgreSQL Database Configuration (Leave DB_NAME blank for SQLite fallback)
DB_NAME=farmkonnect
DB_USER=farmkonnect
DB_PASSWORD=generate-with-deploy/rotate_credentials.py
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Channels Configuration (Leave blank for InMemoryChannelLayer)
REDIS_URL=redis://127.0.0.1:6379/0

# TextSMS Kenya Credentials
TEXTSMS_API_KEY=your-production-textsms-api-key
TEXTSMS_PARTNER_ID=your-textsms-partner-id
TEXTSMS_SHORTCODE=FarmKonnect
TEXTSMS_API_DOMAIN=sms.textsms.co.ke

# SMTP Email Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@zirocreativeagency.co.ke
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=FarmKonnect <no-reply@farmkonnect.zirocreativeagency.co.ke>

# OTP Security (Minutes)
OTP_TTL_MINUTES=10

# AI Models (Google Gemini & ElevenLabs)
# Gemini API key: configure privately in backend/.env; never commit a real key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_SW=21m00Tcm4TlvDq8ikWAM
